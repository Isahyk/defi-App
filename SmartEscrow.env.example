# Preferred env file for this project.
# Rename this file to SmartEscrow.env and replace the placeholder values.

BUYER=0x1111111111111111111111111111111111111111
SELLER=0x2222222222222222222222222222222222222222
# Optional. If omitted, disputes are disabled.
ARBITER=0x3333333333333333333333333333333333333333
# Optional. If omitted, deployer wallet is used.
FEE_RECIPIENT=0x4444444444444444444444444444444444444444
# Optional. Leave zero address for native ETH escrow.
ASSET=0x0000000000000000000000000000000000000000
AMOUNT=1000000000000000000
# Optional. Use either INSPECTION_END or INSPECTION_WINDOW_DAYS.
# INSPECTION_END=1760000000
INSPECTION_WINDOW_DAYS=7
# Optional. Defaults to 250 (2.5%)
FEE_BPS=250
